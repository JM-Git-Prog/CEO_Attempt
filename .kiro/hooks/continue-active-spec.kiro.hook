{
  "enabled": true,
  "name": "Continue Active Spec",
  "description": "When an agent turn ends, review whats been done, update kirograph embeddings, recontinue the active spec tasks",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If any task is incomplete, finish it. "
  },
  "workspaceFolderName": "CEO_Attempt",
  "shortName": "continue-active-spec"
}